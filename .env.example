# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)
# MCP_HTTP_MAX_BODY_BYTES=7340032  # Max inbound JSON-RPC body, bytes. This server defaults to 7 MiB (the
                                   # framework default is 1 MiB): clipboard_write accepts 1 MiB of content,
                                   # and worst-case JSON escaping costs 6 wire bytes per source byte, so a
                                   # 1 MiB write can frame to ~6.3 MB. Set it here to override; 0 disables
                                   # the guard and defers to the reverse proxy.

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateless        # auto | stateful | stateless. Framework default is auto, which resolves
                                    # to stateful; this server defaults to stateless because it keeps no
                                    # per-session state. Set stateful to opt back into the session store.

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Server-specific ──────────────────────────────────────────────────
# CLIPBOARD_READ_ONLY=false         # true | false | 1 | 0 | yes | no | on | off (default: false). When true,
                                    # clipboard_write is not registered: it stays visible on the manifest and
                                    # landing page but is absent from tools/list and uncallable. An
                                    # unrecognized value fails startup.
